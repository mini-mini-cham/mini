function openMd(sq){
  const b=BOOKS.find(x=>x.seq===sq);if(!b)return;lastF=document.activeElement;
  const rd=b.rp===0?'읽기 전':(b.readFinish?'읽기 완료':`<b class="num">${b.rpShow}</b>페이지 읽는 중 / 전체 <b class="num">${b.p}</b>페이지`);
  const ln=!b.learn?'학습 단계 없음':(b.learnFinish?'학습 단계 완료':`<b class="num">${b.lcc}</b>개 완료 / <b class="num">${b.lsc}</b>개의 학습단계`);
  $('#md').innerHTML=`<button class="x" id="mdX" aria-label="닫기">${I('x','s18')}</button>
   <div class="md-g"><span class="md-cv"><span class="bdrop" aria-hidden="true"><img src="${covOf(b)}" alt=""></span>${cover(b)}</span>
    <div class="md-i">
      <div class="ov">${lv(b.sub)}${b.ir?'<span class="bdg core">정독</span>':'<span class="bdg">함께 읽을 도서</span>'}<span class="hx-step">STEP ${b.step}</span></div>
      <h2 class="t-h2" id="mdT">${esc(b.t)}</h2>
      <p>${esc(b.intro)}</p>
      <div class="pl"><div><b>Author</b>${esc(b.a)||'—'}</div><div><b>Genre</b>${esc(b.g)}</div><div><b>Subject</b>${esc(b.s)}</div><div><b>Pages</b><span class="num">${b.p}</span></div></div>
      <div class="sprog"><span class="bar ${b.prog===100?'ok':''}"><i style="width:${b.prog}%"></i></span><span><b class="num">${b.prog}%</b> 진행</span></div>
      <ul class="stt2"><li class="${b.readFinish?'on':''}"><em>READING</em><span>${rd}</span></li><li class="${b.learn&&b.learnFinish?'on':''}"><em>LEARNING</em><span>${ln}</span></li></ul>
      <div class="acts">${acts3(b,'sz-m')}</div>
      
      <p class="tip">${esc(b.pub)} · book_seq ${b.seq}</p>
    </div></div>`;
  $('#scrim').classList.add('on');document.body.style.overflow='hidden';$('#mdX').onclick=closeMd;
  $$('#md [data-act]').forEach(e=>e.onclick=ev=>{ev.stopPropagation();toast(DEMO(e.dataset.act));});
  bindCommon('#md');
  $('#mdX').focus();
}
function openNextMove(){
  const N=KA[CUR_I+1];lastF=document.activeElement;
  $('#md').innerHTML=`<div class="nm"><img src="${DUGI}" alt="" width="104"><span class="t-over">progress_next_move</span><h2 class="t-h2" id="mdT">이번 진도를 다 마쳤어요!</h2>
    <p>다음 진도 <b>${esc(N.sub)} STEP ${N.step}</b>로 넘어갈게요.<br>정독 책은 <b>${esc(N.main.t)}</b>이에요.</p>
    <button class="btn" id="nmOk">${I('arrow-right')}다음 진도 시작하기</button></div>`;
  $('#scrim').classList.add('on');document.body.style.overflow='hidden';
  $('#nmOk').onclick=()=>{closeMd();setMode('base');setSeg(1);};$('#nmOk').focus();
}
function closeMd(){$('#scrim').classList.remove('on');document.body.style.overflow='';if(lastF&&lastF.focus)lastF.focus();}
$('#scrim').onclick=e=>{if(e.target===$('#scrim')&&!$('#nmOk'))closeMd();};
document.addEventListener('keydown',e=>{if(e.key==='Escape'){if($('#scrim').classList.contains('on')&&!$('#nmOk'))closeMd();closeMenus();}});

/* ═══ 화면 전환 · 서버 응답별 상태 ═══ */
function showView(v){$$('#rnav [data-v]').forEach(t=>t.toggleAttribute('aria-current',t.dataset.v===v));if(v==='my')$$('#rnav [data-v="my"]')[0].setAttribute('aria-current','page');else $$('#rnav [data-v="lib"]')[0].setAttribute('aria-current','page');
  $('#viewMy').hidden=v!=='my';$('#viewLib').hidden=v!=='lib';window.scrollTo({top:0});}
$$('#rnav [data-v]').forEach(t=>t.onclick=()=>showView(t.dataset.v));
const MODES=[['base','기본 · STEP 완료형 과제'],['hw','숙제 모드 (my_booklist_option 2)'],['none','진도 미지정'],['fin','레벨 전체 완료'],['move','다음 진도 이동 팝업']];
function setMode(m){MODE=m==='move'?'base':m;$$('#stO button').forEach(b=>b.setAttribute('aria-pressed',b.dataset.m===m));showView('my');OFF=0;$$('#seg button').forEach(x=>x.setAttribute('aria-pressed',x.dataset.seg==='0'));renderMy();if(m==='move')openNextMove();}

$('#stO').innerHTML=MODES.map(([k,t])=>`<button data-m="${k}" aria-pressed="${k==='base'}">${t}</button>`).join('');
$$('#stO button').forEach(b=>b.onclick=()=>setMode(b.dataset.m));
$('#stH').onclick=()=>{const o=$('#stO').hidden;$('#stO').hidden=!o;$('#stH').setAttribute('aria-expanded',o);};
F.g='K';F.sub='K-A';
renderMy();nav1();nav2();nav3();render();
</script>

