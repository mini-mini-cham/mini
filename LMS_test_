@media (max-width:1100px){
  .step{grid-template-columns:1fr}
  .srel{grid-column:auto;margin-top:8px}
  .lmain{grid-template-columns:150px minmax(0,1fr)}
  .rec-g3{grid-template-columns:repeat(3,minmax(0,1fr))}
  .rec-l{grid-column:1/-1}
}
@media (max-width:760px){
  .me-r{margin-left:0;width:100%}
  .dsc-r{flex:1 1 100%}
  .hw{grid-template-columns:1fr}
  .lmain{grid-template-columns:1fr}
  .kv{grid-template-columns:1fr}
  .nx{grid-template-columns:1fr}
  .stbox{width:auto;right:16px}
  .stt2{grid-template-columns:1fr}
}

/* ═══ v23 · v20 기반 + 키즈 요소 최소 차용 ═══ */
.now-p{margin-left:auto;flex:none;height:24px;padding:0 10px;border-radius:999px;background:var(--v600);color:#fff;font-size:12px;line-height:24px;font-weight:700;letter-spacing:0}
.okb{position:absolute;right:14px;top:14px;width:28px;height:28px;border-radius:50%;background:var(--ok);color:#fff;display:grid;place-items:center;box-shadow:0 0 0 3px #fff}
.okt{color:var(--okD);font-weight:700}
.rc-st b{color:var(--v700);font-weight:800}
.kmeta{margin-top:10px;display:flex;flex-wrap:wrap;gap:6px}
.kmeta span{height:26px;padding:0 10px;border-radius:999px;background:var(--g100);font-size:12px;line-height:26px;font-weight:600;color:var(--g600);letter-spacing:0}
.mstk{width:18px;height:18px;border-radius:50%;background:var(--ok);color:#fff;display:grid;place-items:center}
.mstk .i{width:11px;height:11px}
.mini.done .mprog em{color:var(--okD)}
.bubble{box-shadow:0 4px 12px -6px rgba(16,24,40,.18)}
.mi.now .mi-t span{color:var(--g500)}

/* ═══ v26 · 표지색 톤다운 배경 (밀리·교보 도서 상세 방식) ═══ */

/* ═══ v27 · 밀리의서재 방식 : 표지색은 "대표 1권"에만, 목록은 무채색 ═══
   ① 오늘 읽을 책(히어로)과 책 상세 팝업에만 표지를 크게 흐린 배경을 깐다
   ② 반복되는 카드·썸네일은 흰/연회색 면 + 그림자로 두고, 색은 표지 자체가 낸다 */
.stage{isolation:isolate}
.bdrop{position:absolute;left:0;right:0;top:0;bottom:-40px;left:-24px;right:-24px;border-radius:0;overflow:hidden;z-index:-1;
  -webkit-mask-image:linear-gradient(180deg,transparent 0%,rgba(0,0,0,.25) 22%,rgba(0,0,0,.8) 42%,#000 58%,#000 84%,transparent 100%),linear-gradient(90deg,transparent 0%,#000 14%,#000 86%,transparent 100%);-webkit-mask-composite:source-in;mask-image:linear-gradient(180deg,transparent 0%,rgba(0,0,0,.25) 22%,rgba(0,0,0,.8) 42%,#000 58%,#000 84%,transparent 100%),linear-gradient(90deg,transparent 0%,#000 14%,#000 86%,transparent 100%);mask-composite:intersect}
.bdrop img{position:absolute;inset:-20%;width:140%;height:140%;max-width:none;object-fit:cover;filter:blur(36px) saturate(.85);opacity:.9}
.bdrop::after{content:"";position:absolute;inset:0;background:rgba(255,255,255,.4)}
.md-cv .bdrop{-webkit-mask-image:none;mask-image:none;border-radius:inherit}
.rc .tile{background:var(--g50)}
.rc:hover .tile{background:var(--g100)}
.mtile,.mini .mt{background:var(--g50)}
.md-cv{position:relative;overflow:hidden;background:var(--g50);isolation:isolate}
.md-cv .bdrop{top:0;bottom:0;border-radius:inherit}

/* ═══ v29 · 책 정보 영역 재구성 ═══
   문제: 갈래·쪽수·지은이 3종이 한 줄·같은 크기·같은 회색·작은 점으로만 구분 → 위계 없음, 영문 갈래가 길어 빽빽
   해결: ① 지은이는 표지 관례대로 제목 바로 아래 byline  ② 소개문은 Light로 숨 쉬게
         ③ 나머지 사실 정보는 라벨/값 3칸 스펙 줄로 분리 (라벨 12px 연회색, 값 15px 진회색) */
.hx h1{margin-top:16px}
.byline{margin-top:6px;font-size:15px;line-height:22px;font-weight:400;color:var(--g500);letter-spacing:-.005em}
.hx-about{margin-top:14px;font-size:16px;line-height:26px;font-weight:300;color:var(--g700);letter-spacing:-.005em;max-width:42ch}
.facts{margin:22px 0 0;display:flex;gap:0;max-width:420px}
.facts div{flex:1;display:flex;flex-direction:column;gap:4px;padding:0 20px;border-left:1px solid var(--g200)}
.facts div:first-child{padding-left:0;border-left:0}
.facts dt{font-size:12px;line-height:16px;font-weight:500;color:var(--g400);letter-spacing:0}
.facts dd{margin:0;font-size:15px;line-height:22px;font-weight:600;color:var(--g800);letter-spacing:-.01em;white-space:nowrap}
.hx-prog{margin-top:24px}

/* ═══ v31 · 레벨 컬러칩(LMS 동일) + 아이콘 제거 ═══ */
:root{--lv-K:#E2590C;--lv-G1:#F08A1E;--lv-G2:#FBBF63;--lv-G3:#3EBFB4;--lv-G4:#1B8A94;--lv-G5:#1E5F87;--lv-G6:#343C58;--lv-G2-on:#7A4A05}
.lv{background:var(--lvc,var(--g100));color:#fff}
.lv-K{--lvc:var(--lv-K)}.lv-G1{--lvc:var(--lv-G1)}.lv-G2{--lvc:var(--lv-G2);color:var(--lv-G2-on)}.lv-G3{--lvc:var(--lv-G3)}.lv-G4{--lvc:var(--lv-G4)}.lv-G5{--lvc:var(--lv-G5)}.lv-G6{--lvc:var(--lv-G6)}
.hx-ov .lvchip{background:var(--lvc);color:#fff}
.hx-ov .lvchip.lv-G2{color:var(--lv-G2-on)}
.sw{display:inline-block;width:10px;height:10px;border-radius:3px;flex:none}
.lt{gap:8px}.sp{gap:6px}
.okb{width:auto;height:24px;padding:0 10px;border-radius:999px;font-size:12px;line-height:24px;font-weight:700;letter-spacing:0;box-shadow:0 0 0 2px #fff}
.tbtn{flex:none;height:36px;padding:0 14px;border-radius:999px;font-size:13px;font-weight:700;letter-spacing:-.005em;background:var(--g100);color:var(--g800);white-space:nowrap}
.tbtn:hover{background:var(--g200)}
.tbtn.pri{background:var(--v600);color:#fff}
.tbtn.pri:hover{background:var(--v700)}
.mi .no{font-size:14px}
.mi.done .no{background:var(--ok);color:#fff}
.btn,.gbtn,.act,.lk,.kbtn{gap:6px}
.btn{padding:0 28px}

/* ═══ v33 · 레벨 탭: 색 점 제거, 선택 시에만 레벨 색으로 채움 ═══ */
.sw{display:none}
.lt[aria-selected="true"]{background:var(--lc);color:#fff}
.lt[aria-selected="true"] .n{color:rgba(255,255,255,.72)}
.lt.lt-lite[aria-selected="true"]{color:var(--lv-G2-on)}
.lt.lt-lite[aria-selected="true"] .n{color:rgba(122,74,5,.6)}

/* ═══ v34 · 세부 레벨: 오렌지(=행동 버튼 색) 대신 무채색 ═══
   선택 = 진회색 채움 + 흰 글자 / 호버 = 배경 없이 글자만 진하게 (선택과 헷갈리지 않게) */
.sp{background:none;color:var(--g500)}
.sp:hover{background:none;color:var(--g900)}
.sp[aria-pressed="true"]{background:var(--g800);color:#fff}
.sp[aria-pressed="true"] .n{color:rgba(255,255,255,.6)}

/* ═══════════ v35 · 모양(Radius) 시스템 — Apple HIG·Material 3·Primer 기준 ═══════════
   규칙 1. 반경은 4단계만: full(캡슐) · 24(카드) · 12(중첩 카드·팝오버·표지 큰 것) · 8(표지·메뉴 항목)
   규칙 2. 누르는 것(버튼·탭·선택 버튼·칩·STEP 원)은 모두 캡슐(full) — 한 줄 안에서 모양을 섞지 않는다 (Apple Liquid Glass·M3 버튼)
   규칙 3. 담는 것(카드·패널)은 24, 카드 안의 카드·팝오버는 12, 그 안의 항목은 8 (동심원 규칙: 안쪽 = 바깥 − 여백)
   규칙 4. 선택 표시는 1차(레벨)만 레벨 색, 2차 이하(세부 레벨·STEP 전체)는 무채색 회색 (M3 secondary container·Primer segmented) */
:root{--r-full:999px;--r-card:24px;--r-md:12px;--r-sm:8px}
/* 누르는 것 = 캡슐 */
.btn,.gbtn,.tbtn,.act,.kbtn,.more,.rec-btn,.rec-f button,.rec-l button,.seg,.seg button,.lt,.sp,.rail .all,.sel-t,.lk,.chip,.lv,.sst,.tag,.okb,.now-p,.kmeta span,.dday,.st-o button,.top nav a,.toast{border-radius:var(--r-full)}
.st,.mi .no,.ib,.av,.me-sm,.md .x{border-radius:50%}
/* 담는 것 = 카드 24 */
.rc .tile,.mtile,.mis,.dsc,.hw,.nx,.recp,.rail,.md,.stbox{border-radius:var(--r-card)}
/* 카드 안 카드·팝오버 = 12 */
.mi,.mini .mt,.md-cv,.memo,.stt2 li,.resgrid button,.sel-p,.menu,.bubble{border-radius:var(--r-md)}
.bubble{border-radius:var(--r-full)}
/* 표지·메뉴 항목 = 8 (히어로 표지만 12) */
.cv,.rc .cv,.mtile .cv,.mini .cv,.md-cv .cv,.nx-cv .cv,.sel-o,.menu button{border-radius:var(--r-sm)}
.book .cv{border-radius:var(--r-md)}
/* 2차 선택(세부 레벨·STEP 전체) = 무채색 회색 */
.sp{background:none;color:var(--g500)}
.sp:hover{background:none;color:var(--g900)}
.sp[aria-pressed="true"]{background:var(--g200);color:var(--g900)}
.sp[aria-pressed="true"] .n{color:var(--g500)}
.rail .all{background:#fff;color:var(--g600);box-shadow:0 0 0 1px var(--g200)}
.rail .all[aria-pressed="true"]{background:var(--g200);color:var(--g900);box-shadow:none}
.seg button[aria-pressed="true"]{background:#fff;color:var(--g900)}
/* 드롭다운 트리거도 캡슐이므로 좌우 여백 보정 */
.sel-t{padding:0 40px 0 18px}

/* ═══════════════════ v36 · 타이포·간격 위계 시스템 (전수 적용) ═══════════════════
   근거: Material 3 type scale · Fluent 2 type ramp · Primer typography · Polaris text tokens · Apple HIG
   ─ 굵기 3단계만: 400 Regular(본문) · 600 Semibold(라벨·버튼·카드 제목) · 700 Bold(페이지·섹션 제목)   ※ 800 사용 금지 (Primer/Polaris)
     예외 1개: 히어로 책 소개문 300 (요청 사항)
   ─ 크기 9단계 (px/행간):
     display 40/52 · title-1 28/36 · title-2 22/30 · title-3 18/26 · body-lg 17/28 · body 15/24 · label 15/20 · caption 13/18 · overline 12/16
   ─ 자간: 22px 이상 −0.02em, 17–18px −0.01em, 15px 이하 0 (Polaris: 큰 제목만 음수, 작은 글자는 0)
   ─ 글자색 3단계: 기본 g900 · 보조 g600 · 3차 g500  (g400은 비활성 전용, 글자에 사용 안 함 — Fluent 4.5:1)
   ─ 간격 토큰: 4·8·12·16·24·32·48·64 — 섹션 간 64, 제목→내용 16, 카드 안 24, 그리드 24
   ─ 탭: 높이 48, 라벨 16/24 600, 선택 표시 3px (M3·Fluent) */
:root{
  --fs-display:40px;--lh-display:52px;
  --fs-t1:28px;--lh-t1:36px;
  --fs-t2:22px;--lh-t2:30px;
  --fs-t3:18px;--lh-t3:26px;
  --fs-bl:17px;--lh-bl:28px;
  --fs-b:15px;--lh-b:24px;
  --fs-l:15px;--lh-l:20px;
  --fs-c:13px;--lh-c:18px;
  --fs-o:12px;--lh-o:16px;
  --tx1:var(--g900);--tx2:var(--g600);--tx3:var(--g500);
  --sp-1:4px;--sp-2:8px;--sp-3:12px;--sp-4:16px;--sp-6:24px;--sp-8:32px;--sp-12:48px;--sp-16:64px;
}
body{font-size:var(--fs-b);line-height:var(--lh-b);font-weight:400;letter-spacing:0;color:var(--tx1)}
b,strong{font-weight:600}
.num{font-variant-numeric:tabular-nums}

/* ── 1. 글로벌 내비 ── */
.top-in{height:64px}
.logo{font-size:17px;line-height:24px;font-weight:700;letter-spacing:-.01em}
.top nav a{font-size:var(--fs-l);line-height:var(--lh-l);font-weight:600;color:var(--tx2)}
.top nav a[aria-current]{color:var(--tx1)}
.me-sm{font-size:12px;font-weight:600}
.logo i{font-weight:700}

/* ── 2. 페이지 탭 (이번 진도 / 전체 책장) : M3·Fluent 탭 ── */
.rnav{gap:32px;margin-top:0}
.rnav button{height:48px;padding:0;font-size:16px;line-height:24px;font-weight:600;letter-spacing:-.01em;color:var(--tx3)}
.rnav button[aria-current]{color:var(--tx1)}
.rnav .n{font-size:var(--fs-c);font-weight:400;color:var(--tx3);margin-left:4px}

/* ── 3. 프로필 ── */
.me{padding-block:var(--sp-6) var(--sp-4);gap:var(--sp-3)}
.av{font-size:14px;font-weight:600;letter-spacing:0}
.me-name{font-size:var(--fs-t3);line-height:var(--lh-t3);font-weight:700;letter-spacing:-.01em}
.me-t .t-cap{font-size:var(--fs-c);line-height:var(--lh-c);font-weight:400;color:var(--tx3)}
.seg button,.rec-btn{font-size:14px;line-height:20px;font-weight:600;letter-spacing:0}
.stat span{font-size:var(--fs-c);font-weight:400;color:var(--tx3)}
.stat b{font-size:var(--fs-t2);line-height:var(--lh-t2);font-weight:700;letter-spacing:-.02em}
.stat b small{font-size:14px;font-weight:600;color:var(--tx3)}
.rec-l button,.rec-f button{font-size:var(--fs-c);font-weight:600}

/* ── 4. 목표 줄 ── */
.dsc{padding:var(--sp-4) var(--sp-6);margin-bottom:0}
.dsc-l,.dsc-l p{font-size:var(--fs-b);line-height:var(--lh-b);font-weight:400;color:var(--tx2)}
.dsc-l b{font-weight:600;color:var(--v700)}
.dsc-r .row{font-size:var(--fs-c);line-height:var(--lh-c);font-weight:400;color:var(--tx3)}
.dsc-r .row b{font-weight:600;color:var(--tx1)}

/* ── 5. 히어로 (오늘 읽을 책) ── */
.hero{padding-top:var(--sp-8)}
.bubble{font-size:14px;line-height:20px;font-weight:600;letter-spacing:0}
.hx-ov{gap:var(--sp-2)}
.hx-ov .chip{font-size:var(--fs-c);line-height:var(--lh-c);font-weight:600;letter-spacing:0;height:28px;padding:0 12px}
.hx-ov .t-cap{font-size:var(--fs-c);font-weight:400;color:var(--tx3)}
.hx h1{margin-top:var(--sp-4);font-size:var(--fs-display);line-height:var(--lh-display);font-weight:700;letter-spacing:-.02em}
.byline{margin-top:var(--sp-1);font-size:var(--fs-b);line-height:var(--lh-b);font-weight:400;color:var(--tx3);letter-spacing:0}
.hx-about{margin-top:var(--sp-4);font-size:var(--fs-bl);line-height:var(--lh-bl);font-weight:300;color:var(--tx2);letter-spacing:0}
.facts{margin-top:var(--sp-6)}
.facts dt{font-size:var(--fs-o);line-height:var(--lh-o);font-weight:400;color:var(--tx3)}
.facts dd{font-size:var(--fs-b);line-height:var(--lh-b);font-weight:600;color:var(--tx1);letter-spacing:0}
.hx-prog{margin-top:var(--sp-6)}
.hx-prog .row span{font-size:var(--fs-c);line-height:var(--lh-c);font-weight:400;color:var(--tx3)}
.hx-prog .row b{font-size:var(--fs-b);font-weight:600}
.cta{margin-top:var(--sp-6);gap:var(--sp-2)}
.btn{height:52px;font-size:16px;line-height:24px;font-weight:600;letter-spacing:0}
.gbtn{height:52px;font-size:16px;line-height:24px;font-weight:600;letter-spacing:0}
.hx-foot{margin-top:var(--sp-3)}
.lk{font-size:14px;line-height:20px;font-weight:600;color:var(--tx2)}
.lk .n,.gbtn .n,.act .n{font-size:var(--fs-c);font-weight:400;color:var(--tx3)}

/* ── 6. STEP 할 일 ── */
.mis{margin-top:var(--sp-8);padding:var(--sp-6)}
.mis-h b{font-size:var(--fs-t3);line-height:var(--lh-t3);font-weight:700;letter-spacing:-.01em}
.mis-h span{font-size:var(--fs-c);line-height:var(--lh-c);font-weight:400;color:var(--tx3)}
.mi{padding:var(--sp-4)}
.mi .no{font-size:14px;font-weight:600}
.mi-t b{font-size:var(--fs-b);line-height:22px;font-weight:600;letter-spacing:0}
.mi-t span,.mi.now .mi-t span{font-size:var(--fs-c);line-height:var(--lh-c);font-weight:400;color:var(--tx3)}
.mi.done .mi-t span{color:var(--okD)}
.now-p{font-size:var(--fs-o);font-weight:600}

/* ── 7. 섹션 헤더 공통 (함께 읽을 도서 등) ── */
.curate{padding-block:var(--sp-16) 0}
.sh{margin-bottom:var(--sp-6)}
.sh-t{gap:var(--sp-1)}
.sh-t .t-cap,.t-cap{font-size:var(--fs-c);line-height:var(--lh-c);font-weight:400;color:var(--tx3)}
.t-h2{font-size:var(--fs-t2);line-height:var(--lh-t2);font-weight:700;letter-spacing:-.02em}
.t-h2 .hl{font-weight:700}
.t-sm{font-size:var(--fs-b);line-height:var(--lh-b);font-weight:400;color:var(--tx2)}
.t-over{font-size:var(--fs-o);line-height:var(--lh-o);font-weight:600;letter-spacing:.02em;color:var(--tx3)}
.tally{font-size:var(--fs-c);font-weight:400;color:var(--tx3)}
.tally b{font-weight:600;color:var(--tx1)}

/* ── 8. 함께 읽을 도서 카드 ── */
.rgrid{gap:var(--sp-6)}
.rc{gap:var(--sp-4)}
.rc-tx h3,.t-h3{font-size:var(--fs-t3);line-height:var(--lh-t3);font-weight:600;letter-spacing:-.01em}
.rc-st{font-size:var(--fs-c);line-height:var(--lh-c);font-weight:400;color:var(--tx3)}
.rc-st b,.okt{font-weight:600}
.tbtn{font-size:14px;line-height:20px;font-weight:600;height:36px}
.okb{font-size:var(--fs-o);font-weight:600}

/* ── 9. 다음 진도 카드 ── */
.nx{margin-top:var(--sp-8);padding:var(--sp-6)}
.nx-tx{gap:var(--sp-1)}
.nx-tx h3{font-size:var(--fs-t3);line-height:var(--lh-t3);font-weight:600;letter-spacing:-.01em}
.nx-tx .t-sm{font-size:var(--fs-c);line-height:var(--lh-c);color:var(--tx3)}
.endpad{height:96px}

/* ── 10. 전체 책장 : 페이지 제목·필터 ── */
.lib-h{padding-block:var(--sp-12) var(--sp-6);gap:var(--sp-2)}
.lib-h .t-h2{font-size:var(--fs-t1);line-height:var(--lh-t1);font-weight:700;letter-spacing:-.02em}
.lib-h .t-sm{font-size:var(--fs-b);line-height:var(--lh-b);color:var(--tx2)}
.lt{height:44px;font-size:var(--fs-l);line-height:var(--lh-l);font-weight:600;letter-spacing:0}
.lt .n{font-size:var(--fs-c);font-weight:400}
.subrow{margin-top:var(--sp-4)}
.sp{height:36px;font-size:14px;line-height:20px;font-weight:600;letter-spacing:0}
.sp .n{font-size:var(--fs-o);font-weight:400}
.rail{margin-top:var(--sp-4)}
.rail .all{font-size:var(--fs-c);font-weight:600}
.st{font-size:var(--fs-c);font-weight:600}
.fr{padding-block:var(--sp-12) var(--sp-4)}
.fr h2{font-size:var(--fs-t2);line-height:var(--lh-t2);font-weight:700;letter-spacing:-.02em}
.fr h2 em{font-size:var(--fs-b);font-weight:400;color:var(--tx3);letter-spacing:0}
.sel-t{font-size:14px;line-height:20px;font-weight:400;color:var(--tx1)}
.selw.act .sel-t{font-weight:600}
.sel-o,.menu button{font-size:14px;line-height:20px;font-weight:400;color:var(--tx1)}
.sel-o.on{font-weight:600}

/* ── 11. 전체 책장 : STEP 행 (리스트/테이블 행 규격) ── */
.step{padding-block:var(--sp-8);gap:var(--sp-4) var(--sp-8)}
.sno{gap:var(--sp-2)}
.sno b{font-size:var(--fs-b);line-height:var(--lh-b);font-weight:600;color:var(--tx1);letter-spacing:0}
.lv{font-size:var(--fs-o);line-height:var(--lh-o);font-weight:600;letter-spacing:.02em}
.sst{font-size:var(--fs-o);font-weight:600}
.sbody .ov .t-over{font-size:var(--fs-o)}
.sbody h3{margin-top:var(--sp-2);font-size:var(--fs-t2);line-height:var(--lh-t2);font-weight:700;letter-spacing:-.02em}
.kmeta{margin-top:var(--sp-3)}
.kmeta span{font-size:var(--fs-o);font-weight:400;color:var(--tx2)}
.sbody .about{margin-top:var(--sp-3);font-size:var(--fs-b);line-height:var(--lh-b);font-weight:400;color:var(--tx2)}
.sprog{margin-top:var(--sp-4)}
.sprog span{font-size:var(--fs-c);font-weight:400;color:var(--tx3)}
.sprog span b{font-weight:600}
.acts{margin-top:var(--sp-4);gap:var(--sp-2)}
.act{height:44px;font-size:var(--fs-l);line-height:var(--lh-l);font-weight:600;letter-spacing:0}
.srel h4{margin-bottom:var(--sp-3);font-size:var(--fs-b);line-height:var(--lh-b);font-weight:600;color:var(--tx2);letter-spacing:0}
.srel h4 .hl{font-weight:600}
.mini{gap:var(--sp-2)}
.mini h5{font-size:14px;line-height:20px;font-weight:600;letter-spacing:0}
.mprog em,.mini .ms{font-size:var(--fs-o);font-weight:400;color:var(--tx3)}
.mini.done .mprog em{font-weight:600}
.more{font-size:var(--fs-l);font-weight:600}
.more span{font-weight:400;color:var(--tx3)}

/* ── 12. 책 상세 팝업 ── */
.md-i .ov .t-over{font-size:var(--fs-o)}
.md-i h2.t-h2{margin-top:var(--sp-3);font-size:var(--fs-t1);line-height:var(--lh-t1)}
.md-i>p{margin-top:var(--sp-3);font-size:var(--fs-b);line-height:var(--lh-b);font-weight:400;color:var(--tx2)}
.pl{margin-top:var(--sp-6);gap:var(--sp-3) var(--sp-6);padding-block:var(--sp-4)}
.pl div{font-size:14px;line-height:20px;font-weight:400;color:var(--tx1)}
.pl b{font-size:var(--fs-c);font-weight:400;color:var(--tx3)}
.stt2{margin-top:var(--sp-4);gap:var(--sp-2)}
.stt2 li{font-size:14px;line-height:20px;font-weight:400}
.stt2 em{font-size:var(--fs-o);font-weight:600;letter-spacing:.02em}
.stt2 b{font-weight:600}
.resgrid button b{font-size:14px;font-weight:600}
.tip{margin-top:var(--sp-6);font-size:var(--fs-c);line-height:var(--lh-c);font-weight:400;color:var(--tx3)}
.toast{font-size:14px;font-weight:600}
.st-h{font-size:var(--fs-o);font-weight:600}
.st-o button{font-size:var(--fs-c);font-weight:400}
.st-o button[aria-pressed="true"]{font-weight:600}
.empty h3{font-size:var(--fs-t2);line-height:var(--lh-t2);font-weight:700;letter-spacing:-.02em}
.empty p{font-size:var(--fs-b);line-height:var(--lh-b);color:var(--tx2)}
.zero b{font-size:var(--fs-t3);line-height:var(--lh-t3);font-weight:700}
.hw-l{font-size:var(--fs-b)}
.hw-l b{font-weight:600}
.memo p{font-size:var(--fs-b);font-weight:400;color:var(--tx2)}
.dday{font-size:var(--fs-o);font-weight:600}

/* ── 반응형: 작은 화면에서 한 단계씩 낮춤 ── */
@media (max-width:1100px){.hx h1{font-size:34px;line-height:44px}}
@media (max-width:760px){
  :root{--fs-display:30px;--lh-display:38px;--fs-t1:24px;--lh-t1:32px;--fs-t2:20px;--lh-t2:28px;--fs-bl:16px;--lh-bl:26px}
  .hx h1{font-size:var(--fs-display);line-height:var(--lh-display)}
  .curate{padding-block:var(--sp-12) 0}
  .mis{padding:var(--sp-4)}
}

/* ═══════════ v37 · 배지(딱지) 시스템 — Primer Label · Polaris Badge · Geist Badge/Status Dot · Atlassian Lozenge ═══════════
   원칙 ① 배지는 "분류"에만: 레벨 · 정독. 한 줄에 2개까지 (Geist: one badge per row 권장)
   원칙 ② "상태"는 점+글자: 완료 · 지금 · 이번 진도 (Geist Status Dot, Polaris progress pip)
   원칙 ③ "설명 정보"는 평문: 갈래 · 주제 · 쪽수 · 지은이를 가운뎃점으로 (Atlassian: metadata는 Tag/텍스트)
   원칙 ④ 꽉 찬 색 채움 금지 → 옅은 틴트 + 같은 색상의 진한 글자 (Polaris subtle tone), 대비 4.5:1 이상 */
.bdg,.lv{display:inline-flex;align-items:center;height:22px;padding:0 8px;border-radius:999px;font-size:12px;line-height:1;font-weight:600;letter-spacing:0;white-space:nowrap;background:var(--g100);color:var(--g700);box-shadow:none}
/* 레벨: 레벨색 12% 틴트 + 레벨색을 어둡게 한 글자 */
.lv{background:color-mix(in srgb,var(--lvc,var(--g500)) 13%,#fff);color:color-mix(in srgb,var(--lvc,var(--g700)) 78%,#000);letter-spacing:.02em}
.lv.lv-G2{color:var(--lv-G2-on);background:color-mix(in srgb,var(--lv-G2) 28%,#fff)}
/* 정독: 무채색 외곽선 (Primer Label outline) */
.bdg.core{background:#fff;color:var(--g700);box-shadow:inset 0 0 0 1px var(--g300)}
/* 상태 점 + 글자 */
.dot-s{display:inline-flex;align-items:center;gap:6px;font-size:13px;line-height:18px;font-weight:600;letter-spacing:0;color:var(--g600);white-space:nowrap}
.dot-s::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor;flex:none}
.dot-s.done{color:var(--okD)}
.dot-s.done::before{background:var(--ok)}
.dot-s.now{color:var(--v700);margin-left:auto}
.dot-s.now::before{background:var(--v600);box-shadow:0 0 0 3px color-mix(in srgb,var(--v600) 22%,transparent);animation:nowp 1.8s ease-in-out infinite}
@keyframes nowp{50%{box-shadow:0 0 0 5px color-mix(in srgb,var(--v600) 10%,transparent)}}
.dot-s.sm{font-size:12px;gap:5px}.dot-s.sm::before{width:6px;height:6px}
.sno .dot-s.now{margin-left:0}
/* 표지 위 완료: 흰 알약 + 점 (Geist: 체크 아이콘 대신 색점) */
.okb{position:absolute;right:12px;top:12px;width:auto;height:26px;padding:0 10px;border-radius:999px;background:rgba(255,255,255,.92);box-shadow:0 1px 2px rgba(16,24,40,.12);display:inline-flex;align-items:center}
.okb .dot-s{font-size:12px}
/* 히어로 한 줄: 배지 2개 + STEP 텍스트 */
.hx-ov{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.hx-step{margin-left:4px;font-size:13px;line-height:18px;font-weight:600;color:var(--g600);letter-spacing:0}
.hx-step i{font-style:normal;margin:0 6px;color:var(--g300)}
.md-i .ov{gap:6px}
/* 설명 정보: 평문 */
.meta2{margin-top:10px;font-size:13px;line-height:18px;font-weight:400;color:var(--g500)}
.meta2 i{font-style:normal;margin:0 7px;color:var(--g300)}
.kmeta{display:none}
@media (prefers-reduced-motion:reduce){.dot-s.now::before{animation:none}}

/* ═══ v38 · 아바타 무채색 (색은 행동·상태에만) ═══ */
.av,.me-sm{background:var(--g100);color:var(--g700);box-shadow:none}

/* ═══ v39 · STEP 할 일 = 스테퍼 (IBM Carbon Progress indicator · Atlassian Progress tracker · Material stepper) ═══
   박스·테두리 없음. 현재 단계는 ① 링 마커 ② 굵은 제목 ③ 오렌지 보조줄 3가지로만 강조
   완료 = 블루 채움 원 + 블루 연결선 / 현재 = 오렌지 링(가운데 점) / 예정 = 회색 테두리 원 + 회색 연결선 */
.mis{display:grid;grid-template-columns:auto minmax(0,1fr);gap:var(--sp-8);align-items:start}
.mis-h{padding-top:2px}
.stp{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}
.stp li{min-width:0}
.stp button{width:100%;display:flex;flex-direction:column;gap:12px;text-align:left;padding:0;background:none;border:0;border-radius:12px}
.stp-r{display:flex;align-items:center;width:100%}
.mk{flex:none;width:24px;height:24px;border-radius:50%;display:grid;place-items:center;font-size:12px;font-weight:600;letter-spacing:0;background:#fff;color:var(--g500);box-shadow:inset 0 0 0 1.5px var(--g300)}
.done .mk{background:var(--ok);color:#fff;box-shadow:none}
.now .mk{background:radial-gradient(circle,var(--v600) 0 5px,#fff 5.5px);box-shadow:inset 0 0 0 2px var(--v600),0 0 0 4px color-mix(in srgb,var(--v600) 16%,transparent)}
.cn{flex:1;height:2px;margin:0 10px;border-radius:2px;background:var(--g200)}
.cn.on{background:var(--ok)}
.stp-t{display:flex;flex-direction:column;gap:2px;padding-right:16px;min-width:0}
.stp-t b{font-size:15px;line-height:22px;font-weight:600;color:var(--tx2);letter-spacing:0}
.stp-t span{font-size:13px;line-height:18px;font-weight:400;color:var(--tx3)}
.stp-t i{font-style:normal;margin:0 5px;color:var(--g300)}
.done .stp-t span{color:var(--okD)}
.now .stp-t b{color:var(--tx1);font-weight:700}
.now .stp-t span{color:var(--v700);font-weight:600}
.stp button:hover .stp-t b{color:var(--tx1)}
.stp button:focus-visible{outline:2px solid var(--v600);outline-offset:6px}
@media (max-width:1100px){.mis{grid-template-columns:1fr;gap:var(--sp-4)}}
@media (max-width:760px){.stp{grid-template-columns:1fr;gap:16px}.cn{display:none}}

/* ═══ v40 · STEP 할 일 = 세그먼트 트랙 (Toss TDS ProgressStepper compact · Instagram 세그먼트 바) ═══
   원·박스·연결선 없음. 칸 하나 = 쪽 하나 / 학습 단계 하나 / 책 한 권 → 남은 양을 셀 수 있음
   완료 = 블루 칸 + "완료" · 지금 = 오렌지 칸 + 다음 칸 옅은 오렌지 + 굵은 제목 · 예정 = 회색 칸 */
.mis{display:block;padding:var(--sp-6) var(--sp-8)}
.mis-h{display:flex;align-items:baseline;gap:10px;margin-bottom:var(--sp-4);padding:0}
.stp{display:none}
.trk{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:var(--sp-8)}
.tk{display:flex;flex-direction:column;gap:6px;text-align:left;padding:0;background:none;border:0;min-width:0}
.tk-now{height:16px;font-size:12px;line-height:16px;font-weight:600;color:var(--v700);letter-spacing:0}
.tk-h{display:flex;align-items:baseline;justify-content:space-between;gap:12px;min-width:0}
.tk-h b{font-size:15px;line-height:22px;font-weight:500;color:var(--g500);letter-spacing:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tk-h em{flex:none;font-style:normal;font-size:13px;line-height:18px;font-weight:600;color:var(--g400)}
.sg{display:flex;gap:3px;margin-top:4px}
.sg i{flex:1;height:6px;border-radius:3px;background:var(--g100);transition:background-color .32s ease-out}
.tk.done .tk-h em{color:var(--okD)}
.tk.done .sg i.on{background:var(--ok)}
.tk.now .tk-h b{font-size:16px;font-weight:700;color:var(--tx1)}
.tk.now .tk-h em{font-size:14px;font-weight:700;color:var(--v700)}
.tk.now .sg i.on{background:var(--v600)}
.tk.now .sg i.nxt{background:var(--v200)}
.tk.todo .sg i.on{background:var(--g300)}
.tk:hover .tk-h b{color:var(--tx1)}
.tk:focus-visible{outline:2px solid var(--v600);outline-offset:6px;border-radius:8px}
@media (max-width:760px){.trk{grid-template-columns:1fr;row-gap:16px}.mis{padding:var(--sp-4)}}

/* ═══ v41 · 히어로 ↔ STEP 할 일 여백: 표지 빛이 아래 패널을 덮지 않도록 ═══ */
.bdrop{bottom:0}
.mis{margin-top:var(--sp-12)}

/* ═══ v42 · 버튼 위계 — M3(filled→tonal→outlined) · Apple HIG(prominent 1개) · Primer/Polaris(영역당 primary 1개) ═══
   ① 원래 서비스처럼 3버튼을 항상 같은 순서·같은 자리에: 읽기 → 학습하기 → 자료
   ② 강조는 "다음에 할 일" 1개만 채움(오렌지). 나머지 행동은 회색 채움(tonal), 자료는 외곽선(outlined, 드롭다운)
   ③ 라벨은 고정(읽기/학습하기/자료), 진행 상황은 버튼 안 작은 숫자로 */
.cta,.acts{display:flex;align-items:center;gap:var(--sp-2);flex-wrap:wrap}
.b3{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:999px;font-weight:600;letter-spacing:0;white-space:nowrap;transition:background .15s,box-shadow .15s}
.b3.sz-l{height:52px;padding:0 24px;font-size:16px;min-width:112px}
.b3.sz-m{height:44px;padding:0 18px;font-size:15px;min-width:92px}
.b3 .c{font-size:13px;font-weight:600;opacity:.85}
.b3.pri{background:var(--v600);color:#fff;box-shadow:0 8px 16px -10px color-mix(in srgb,var(--v600) 80%,transparent)}
.b3.pri:hover{background:var(--v700)}
.b3.ton{background:var(--g100);color:var(--g900)}
.b3.ton:hover{background:var(--g200)}
.b3.ton .c{color:var(--g500)}
.b3.out{background:#fff;color:var(--g900);box-shadow:inset 0 0 0 1px var(--g300)}
.b3.out:hover{box-shadow:inset 0 0 0 1px var(--g400)}
.b3.out .c{color:var(--g500)}
.b3 .car{width:14px;height:14px;color:var(--g500);margin-left:-2px}
.b3[aria-expanded="true"] .car{rotate:180deg}
.cta .dd .menu,.acts .dd .menu{left:0;top:calc(100% + 6px);bottom:auto}
.hx-foot,.resgrid{display:none!important}

/* ═══ v43 · 운영 중인 용어로 되돌림 : READING · LEARNING · RESOURCES / My Booklist · eLibrary / Author·Genre·Subject·Pages ═══ */
.b3{letter-spacing:.01em}
.stp-t b,.tk-h b{letter-spacing:.01em}
.facts dd{white-space:normal}

/* ═══ v44 · 3버튼 같은 너비 · 숫자 제거 ═══ */
.b3.sz-l{width:156px;min-width:0;padding:0 12px}
.b3.sz-m{width:136px;min-width:0;padding:0 10px}
.b3 .car{margin-left:0}
@media (max-width:760px){.cta,.acts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}.b3.sz-l,.b3.sz-m{width:100%}.cta .dd,.acts .dd{display:block}}

/* ═══ v45 · 메뉴 버튼 정렬 — Primer Button trailingAction · Polaris Button disclosure · Apple pull-down button ═══
   고정 너비 버튼에서는 라벨만 가운데 정렬하고, 화살표는 오른쪽 끝에 고정(trailing action)
   → 세 버튼의 글자 중심선이 같은 위치에 맞는다 */
.b3{position:relative}
.b3.sz-l{width:160px}
.b3.sz-m{width:144px}
.b3 .car.trail{position:absolute;right:14px;top:50%;translate:0 -50%;width:12px;height:12px;margin:0;color:var(--g500);transition:rotate .2s}
.b3[aria-expanded="true"] .car.trail{rotate:180deg}
.b3.sz-m .car.trail{right:12px}

/* ═══ v46 · 메뉴 화살표 전용 공간 확보 (Primer trailingAction · Atlassian 12px chevron · 간격 8px 이상) ═══
   세 버튼 모두 좌우 안쪽 여백 32px 동일 → 라벨 중심선 일치
   화살표는 오른쪽 12px 안쪽, 12px 크기 → 라벨 끝과 최소 12px 떨어짐 (아슬아슬하게 붙지 않음) */
.b3.sz-l,.b3.sz-m{padding-inline:32px}
.b3.sz-l{width:168px}
.b3.sz-m{width:160px}
.cta{flex-wrap:nowrap}
.b3 .car.trail,.b3.sz-m .car.trail{right:14px;width:12px;height:12px;color:var(--g400)}
.b3.out:hover .car.trail{color:var(--g600)}

/* ═══ v48 · 히어로 정보 영역 그리드 — 버튼 3칸(168·8·168·8·168 = 520px)을 기준 열로 삼아 모든 요소를 맞춤 ═══
   (Material 3·Primer 레이아웃: 같은 열 폭에 콘텐츠를 정렬, 불필요한 빈 칸 제거)
   ① 소개문·정보·진행 막대·버튼 = 모두 520px 한 폭
   ② Genre/Subject/Pages 3칸 = 아래 버튼 3칸과 같은 폭·같은 간격 → 세로 정렬선이 맞음, 줄바꿈 없음
   ③ 완료 시 "100% 진행" 글자도 블루 */
.hx{--col:520px}
.hx-about{max-width:var(--col)}
.facts{display:grid;grid-template-columns:repeat(3,168px);column-gap:8px;max-width:var(--col);margin-top:var(--sp-6)}
.facts div{padding:0;border-left:0;min-width:0;gap:2px}
.facts div:first-child{padding-left:0}
.facts dd{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hx-prog{max-width:var(--col)}
.hx-prog .row{justify-content:flex-start}
.hx-prog.done .row b{color:var(--okD)}
.cta{max-width:var(--col)}
@media (max-width:760px){.hx{--col:100%}.facts{grid-template-columns:repeat(3,minmax(0,1fr))}}

/* ═══ v49 · 완료(done) = 무채색 — Linear·Todoist·Polaris Setup guide·Atlassian Progress tracker
   완료된 항목은 "끝났으니 덜 보여도 되는 것" → 회색으로 한 단계 가라앉히고, 시선은 지금 할 일(오렌지)에만 모은다
   블루는 면적 없이 "● 완료" 상태 점 하나에만 남긴다 ═══ */
:root{--done:#98A2B3;--doneT:var(--g600)}
/* STEP 할 일 트랙 */
.tk.done .sg i.on{background:var(--done)}
.tk.done .tk-h em{color:var(--doneT)}
.tk.done .tk-h b{color:var(--g500)}
/* 완료된 진행 막대 (히어로·eLibrary·팝업) */
.bar.ok i,.bar.ok>i{background:var(--done)}
.hx-prog.done .row b{color:var(--doneT)}
.sprog .bar.ok+span b,.step.done .sprog span b{color:var(--doneT)}
/* 레벨 진도 막대(목표 줄)도 무채색 */
.dsc-r .bar i{background:var(--g700)}
/* 함께 읽을 도서 개수 표시 */
.pips i.on{background:var(--done)}
/* 상태 점: 점만 블루, 글자는 회색 */
.dot-s.done{color:var(--doneT)}
.dot-s.done::before{background:var(--ok)}
.okb .dot-s.done{color:var(--g700)}
.mini.done .mprog em,.rc-st .okt{color:var(--doneT)}
.stt2 li.on{background:var(--g100);color:var(--g700)}
.stt2 li.on em{color:var(--g500)}

/* ═══ v50 · 레벨 진도 = 보조색(블루) — Material 3 color roles(primary=핵심 행동, secondary=덜 두드러진 요소)
   · Primer/Polaris ProgressBar 기본 강조색 → 오렌지는 "지금 할 일", 블루는 "레벨 전체 여정"으로 역할 분리 ═══ */
.dsc-r .bar{background:var(--okT)}
.dsc-r .bar i{background:var(--ok)}
.dsc-l b{color:var(--okD)}

/* ═══ v51 · 아이콘 최소화 — 글자로 뜻이 충분하면 장식 아이콘을 빼고(Apple HIG·M3: 아이콘은 인식을 돕는 경우에만),
   펼침 표시(▾)만 남긴다. 화살표는 RESOURCES와 같은 12px·연회색으로 통일 ═══ */
.rec-btn{gap:6px;padding:0 14px 0 16px;height:40px;font-size:14px;font-weight:600;color:var(--g800)}
.rec-btn .car{width:12px;height:12px;color:var(--g400);transition:rotate .2s}
.rec-btn:hover .car{color:var(--g600)}

/* ═══ v52 · 캐릭터 말풍선 = 서비스 아이덴티티 1곳 (Duolingo 방식: 흰 말풍선 + 2px 테두리 + 납작한 입체 그림자 + 캐릭터 쪽 꼬리)
   귀여운 글꼴(Jua)은 말풍선 안에서만 — 나머지 UI는 Pretendard 유지 (미니멀) ═══ */
.stage .bubble,.bubble{
  top:-6px;padding:10px 20px 11px;border-radius:20px;background:#fff;color:#2B2D42;
  font-family:'Jua','Pretendard Variable',Pretendard,sans-serif;font-weight:400;font-size:20px;line-height:1.35;letter-spacing:0;
  border:2px solid #E6E6EA;box-shadow:0 3px 0 #E6E6EA;white-space:nowrap;
  animation:bpop .36s cubic-bezier(.34,1.56,.64,1) both,bbob 3.2s ease-in-out .5s infinite}
.stage .bubble::after,.bubble::after{
  content:"";position:absolute;left:50%;bottom:-9px;width:14px;height:14px;background:#fff;
  border:0;border-right:2px solid #E6E6EA;border-bottom:2px solid #E6E6EA;border-bottom-right-radius:4px;
  transform:translateX(-50%) rotate(45deg);translate:none}
@keyframes bpop{from{opacity:0;transform:scale(.7) translateY(6px)}to{opacity:1;transform:none}}
@keyframes bbob{50%{transform:translateY(-3px)}}
@media (prefers-reduced-motion:reduce){.bubble{animation:none}}
@media (max-width:1100px){.stage .bubble{font-size:18px}}
@media (max-width:760px){.stage .bubble{font-size:17px;padding:8px 16px 9px}}


/* ═══════════ v54 · 토스 "키워봐요 적금" 방식 — 캐릭터가 주인공인 무대, 나머지는 미니멀
   ① 말풍선: UI 글꼴(Pretendard) 그대로, 흰 알약 + 은은한 그림자 (토스: "말풍선에도 은은한 그림자로 영역 구분")
   ② 발밑 그림자: 책이 허공에 떠 보이지 않도록 바닥 타원 그림자 (토스: "캐릭터 발밑에 그림자")
   ③ 진행 바의 시그니처 마커: 토스의 발자국 대신 우리 캐릭터 얼굴이 진행 끝을 따라감 → "캐릭터가 걸어온 길"
   ④ 반응 모션: 캐릭터가 천천히 숨 쉬듯 움직이고, 책에 마우스를 올리면 고개를 쏙 내밀어 반응 ═══════════ */
/* ① 말풍선 */
.stage .bubble,.bubble{
  top:-4px;padding:10px 18px;border:0;border-radius:999px;background:#fff;color:var(--g900);
  font-family:var(--f);font-weight:700;font-size:15px;line-height:22px;letter-spacing:-.01em;white-space:nowrap;
  box-shadow:0 0 0 1px rgba(16,24,40,.04),0 8px 20px -8px rgba(16,24,40,.22);
  animation:bpop .4s cubic-bezier(.34,1.56,.64,1) .15s both}
.stage .bubble::after,.bubble::after{display:none}
@keyframes bpop{from{opacity:0;transform:translateY(8px) scale(.92)}to{opacity:1;transform:none}}
/* ② 발밑 그림자 */
.stage .book::after{content:"";position:absolute;left:50%;bottom:-20px;width:86%;height:28px;translate:-50% 0;z-index:-1;
  background:radial-gradient(closest-side,rgba(16,24,40,.26),rgba(16,24,40,0));filter:blur(4px);pointer-events:none}
.book .cv{box-shadow:0 1px 2px rgba(16,24,40,.08),0 10px 24px -14px rgba(16,24,40,.35)}
/* ③ 진행 바 + 캐릭터 마커 */
.hx-prog .bar.trk-bar{position:relative;overflow:visible;height:10px;margin-top:6px}
.hx-prog .bar.trk-bar>i{background:linear-gradient(90deg,var(--v200),var(--v600));transition:width .9s cubic-bezier(.2,.8,.2,1)}
.hx-prog .bar.trk-bar.ok>i{background:var(--done)}
.pmk{position:absolute;top:50%;width:30px;height:30px;translate:-50% -50%;border-radius:50%;background:#fff;object-fit:cover;
  box-shadow:0 0 0 2px #fff,0 4px 10px -2px rgba(16,24,40,.25);animation:pmk .9s cubic-bezier(.34,1.56,.64,1) .3s both}
@keyframes pmk{from{opacity:0;scale:.4}to{opacity:1;scale:1}}
/* ④ 캐릭터 모션 */
.stage .peek{animation:breathe 4.8s ease-in-out infinite;transition:top .35s cubic-bezier(.34,1.56,.64,1)}
@keyframes breathe{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}
.stage:has(.book:hover) .peek{top:calc(var(--bw)*.105 - 12px)}
.stage .book{transition:transform .3s cubic-bezier(.2,.8,.2,1)}
.stage .book:hover{transform:translateY(-2px)}
@media (prefers-reduced-motion:reduce){.stage .peek,.pmk,.bubble{animation:none}}
</style>

