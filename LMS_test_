<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<style>[hidden]{display:none!important}body{margin:0}</style>
</head>
<body>
<title>참빛 리딩룸</title>
<style>
@font-face{font-family:'Pretendard Variable';font-weight:45 920;font-style:normal;font-display:swap;
  src:url(data:font/woff2;base64,) format('woff2')}
/* Layout: 1200 컨테이너 · 12컬럼(거터 24) · 4px 그리드 · 섹션 간 88 / 제목→내용 28
   Type (Pretendard, 굵기 500·700·800만):
   Display 44/54 800 -3.5% · H2 26/34 800 -2.5% · H3 18/26 700 -1.5% · Body 16/26 500 -1% · Sm 14/22 500 -.5% · Cap 13/18 600 · Over 12/16 700 +2% */
:root{
  color-scheme:light;
  --g25:#FCFCFD;--g50:#F9FAFB;--g100:#F2F4F7;--g200:#EAECF0;--g300:#D0D5DD;--g400:#98A2B3;--g500:#667085;--g600:#475467;--g700:#344054;--g800:#182230;--g900:#101828;
  --v50:#FFF6EF;--v100:#FFEBDB;--v200:#FFD6B8;--v600:#FF9445;--v700:#D9661A;
  --ok:#53BCF0;--okD:#1A84B8;--okT:#EAF6FE;--warm:#F79009;--gold:#F5A524;
  --bg:#FFFFFF;--tile:#F4F3F8;--tileH:#ECEAF3;
  --r-s:8px;--r-m:12px;--r-l:20px;--r-f:9999px;
  --sh-cv:0 1px 2px rgba(16,24,40,.08),0 10px 24px -10px rgba(16,24,40,.28);
  --sh-cvH:0 1px 2px rgba(16,24,40,.08),0 18px 32px -12px rgba(16,24,40,.32);
  --sh-pop:0 0 0 1px var(--g200),0 16px 32px -8px rgba(16,24,40,.14);
  --f:'Pretendard Variable',Pretendard,-apple-system,BlinkMacSystemFont,system-ui,'Apple SD Gothic Neo','Noto Sans KR',sans-serif;
  --E:cubic-bezier(.2,.8,.2,1);
}
*{box-sizing:border-box}
html,body{background:var(--bg)}
body{margin:0;color:var(--g900);font-family:var(--f);font-size:16px;line-height:26px;font-weight:500;letter-spacing:-.01em;
  -webkit-font-smoothing:antialiased;word-break:keep-all}
button{font:inherit;color:inherit;letter-spacing:inherit;background:none;border:0;padding:0;cursor:pointer}
h1,h2,h3,h4,p{margin:0}
img{max-width:100%;display:block}
:focus-visible{outline:2px solid var(--v600);outline-offset:2px;border-radius:8px}
.num{font-variant-numeric:tabular-nums}
.wrap{max-width:1200px;margin:0 auto;padding-inline:32px}
.i{width:20px;height:20px;fill:currentColor;flex:none;display:block}
.i.s16{width:16px;height:16px}.i.s18{width:18px;height:18px}.i.s22{width:22px;height:22px}.i.s24{width:24px;height:24px}

/* type roles */
.t-over{font-size:12px;line-height:16px;font-weight:700;letter-spacing:.02em;color:var(--g500)}
.t-cap{font-size:13px;line-height:18px;font-weight:600;letter-spacing:0;color:var(--g500)}
.t-sm{font-size:14px;line-height:22px;font-weight:500;letter-spacing:-.005em;color:var(--g600)}
.t-h3{font-size:18px;line-height:26px;font-weight:700;letter-spacing:-.015em}
.t-h2{font-size:26px;line-height:34px;font-weight:800;letter-spacing:-.025em}
.dot::before{content:"";display:inline-block;width:3px;height:3px;border-radius:50%;background:var(--g300);margin:0 8px;vertical-align:middle;translate:0 -2px}

.cv{display:block;aspect-ratio:1000/923;max-width:100%;overflow:hidden;background:var(--g100)}
.cv img{width:100%;height:100%;object-fit:cover}
.cvw{display:block;text-align:left}
/* chips */
.lv{display:inline-flex;align-items:center;height:24px;padding:0 8px;border-radius:6px;background:var(--v50);color:var(--v700);font-size:12px;line-height:16px;font-weight:800;letter-spacing:.02em}
.chip{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 10px;border-radius:var(--r-s);font-size:13px;line-height:18px;font-weight:700;letter-spacing:0}

/* ── GNB ── */
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:60;background:rgba(255,255,255,.88);backdrop-filter:saturate(1.4) blur(12px);border-bottom:1px solid var(--g200)}
.top-in{display:flex;align-items:center;height:68px;gap:40px}
.logo{display:flex;align-items:center;gap:10px;font-size:16px;line-height:24px;font-weight:800;letter-spacing:-.02em;white-space:nowrap}
.logo i{width:32px;height:32px;border-radius:10px;background:var(--v600);color:#fff;display:grid;place-items:center;font-style:normal;font-size:15px;font-weight:800}
.top nav{display:flex;gap:4px}
.top nav a{text-decoration:none;color:var(--g500);font-size:15px;line-height:22px;font-weight:600;padding:8px 14px;border-radius:var(--r-f)}
.top nav a:hover{color:var(--g900)}
.top nav a[aria-current]{color:var(--g900);background:var(--g100)}
.top-r{margin-left:auto;display:flex;align-items:center;gap:8px}
.ib{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;color:var(--g600)}
.ib:hover{background:var(--g100);color:var(--g900)}
.me-sm{width:36px;height:36px;border-radius:50%;background:var(--v100);color:var(--v700);display:grid;place-items:center;font-size:12px;font-weight:800}

/* ── 프로필 : 한 줄 ── */
.me{display:flex;align-items:center;gap:12px;padding-block:24px 20px}
.av{width:44px;height:44px;border-radius:50%;background:var(--v100);color:var(--v700);display:grid;place-items:center;font-size:14px;font-weight:800;letter-spacing:-.02em;flex:none}
.me-name{font-size:20px;line-height:28px;font-weight:800;letter-spacing:-.025em}
.streak{display:inline-flex;align-items:center;gap:4px;height:28px;padding:0 10px 0 8px;border-radius:var(--r-f);background:#FFF6ED;color:#B54708;font-size:13px;font-weight:700;letter-spacing:0}
.streak .i{color:var(--warm)}
.rec-btn{margin-left:auto;height:40px;padding:0 12px 0 14px;border-radius:var(--r-f);display:inline-flex;align-items:center;gap:6px;font-size:14px;font-weight:700;color:var(--g700);background:var(--g100);letter-spacing:-.005em}
.rec-btn:hover{background:var(--g200);color:var(--g900)}
.rec-btn .car{transition:rotate .2s}
.rec-btn[aria-expanded="true"] .car{rotate:180deg}
.recp{margin-bottom:20px;padding:24px 28px;border-radius:var(--r-l);background:var(--g50)}
.rec-g{display:grid;grid-template-columns:repeat(3,minmax(0,1fr)) minmax(0,2fr);gap:24px}
.stat{display:flex;flex-direction:column;gap:2px;min-width:0}
.stat span{font-size:13px;line-height:18px;font-weight:600;color:var(--g500);letter-spacing:0}
.stat b{font-size:22px;line-height:30px;font-weight:800;letter-spacing:-.02em;color:var(--g900)}
.stat b small{font-size:14px;font-weight:700;margin-left:2px;color:var(--g500)}
.stat .asg{font-size:16px;line-height:24px;padding-top:3px}
.stat em{font-style:normal;font-size:13px;line-height:18px;color:var(--g500);font-weight:500}
.stat.wide{padding-left:24px;border-left:1px solid var(--g200)}
.rec-f{margin-top:20px;padding-top:16px;border-top:1px solid var(--g200);display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.rec-f .t-cap{margin-right:4px}
.rec-f button{height:34px;padding:0 14px;border-radius:var(--r-f);background:#fff;box-shadow:0 0 0 1px var(--g200);font-size:13px;font-weight:700;color:var(--g700);letter-spacing:0}
.rec-f button:hover{box-shadow:0 0 0 1px var(--g400);color:var(--g900)}


.tabbar{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;border-bottom:1px solid var(--g200);flex-wrap:wrap}
.vtabs{display:flex;gap:32px}
.vtab{display:inline-flex;align-items:center;gap:8px;padding:12px 0 14px;font-size:17px;line-height:26px;font-weight:700;letter-spacing:-.015em;color:var(--g400);position:relative}
.vtab:hover{color:var(--g700)}
.vtab[aria-selected="true"]{color:var(--g900)}
.vtab[aria-selected="true"]::after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:3px;border-radius:3px 3px 0 0;background:var(--g900)}
.vtab .n{font-size:13px;font-weight:700;color:var(--g400)}
.seg{display:inline-flex;padding:4px;border-radius:var(--r-f);background:var(--g100);margin-bottom:10px}
.seg button{height:32px;padding:0 14px;border-radius:var(--r-f);font-size:14px;line-height:20px;font-weight:700;color:var(--g500);letter-spacing:-.005em}
.seg button:hover{color:var(--g800)}
.seg button[aria-pressed="true"]{background:#fff;color:var(--g900);box-shadow:0 1px 2px rgba(16,24,40,.08),0 0 0 1px rgba(16,24,40,.04)}

/* ── 히어로 (캐릭터 비율 고정) ── */
.hero{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;padding-block:32px 0;--bw:305px}
.stage{grid-column:1/span 5;position:relative;width:calc(var(--bw)*1.443);max-width:100%;padding-top:calc(var(--bw)*.433);overflow:visible}
.stage .peek{position:absolute;left:50%;translate:-50% 0;top:calc(var(--bw)*.105 - 3px);width:calc(var(--bw)*.885);height:auto;z-index:1;pointer-events:none}
.stage .book{position:relative;z-index:2;display:block;width:var(--bw);margin:0 auto}
.bubble{position:absolute;left:50%;translate:-50% 0;top:0;z-index:0;white-space:nowrap;font-size:14px;line-height:20px;font-weight:700;letter-spacing:-.01em;color:var(--g800);padding:10px 16px;border-radius:16px;background:var(--g100)}
.bubble::after{content:"";position:absolute;left:50%;bottom:-8px;translate:-50% 0;border:8px solid transparent;border-top-color:var(--g100);border-bottom:0}
.book .cv{border-radius:12px;box-shadow:var(--sh-cvH)}
.hx{grid-column:7/span 6;min-width:0;display:flex;flex-direction:column;padding-top:28px}
.hx-ov{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.hx-ov .chip{background:var(--v600);color:#fff}
.hx-ov .chip .i{width:16px;height:16px}
.hx-ov .t-cap{color:var(--g600)}
.hx h1{margin-top:18px;font-size:44px;line-height:54px;font-weight:800;letter-spacing:-.035em;text-wrap:balance;overflow-wrap:anywhere}
.hx-meta{margin-top:8px;display:flex;align-items:center;flex-wrap:wrap;font-size:15px;line-height:22px;color:var(--g500);font-weight:500}
.hx-meta .lv{margin-right:10px}
.hx-about{margin-top:16px;font-size:16px;line-height:26px;color:var(--g600);max-width:44ch}
.hx-prog{margin-top:28px;max-width:420px;display:flex;flex-direction:column;gap:10px}
.hx-prog .row{display:flex;justify-content:space-between;align-items:baseline;font-size:14px;line-height:20px;color:var(--g500);font-weight:600;letter-spacing:0}
.hx-prog .row b{font-size:16px;font-weight:800;color:var(--v700)}
.bar{display:block;height:10px;border-radius:var(--r-f);background:var(--g100);overflow:hidden}
.bar i{display:block;height:100%;border-radius:inherit;background:var(--v600)}
.cta{margin-top:24px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.btn{height:56px;padding:0 28px 0 24px;border-radius:var(--r-f);display:inline-flex;align-items:center;justify-content:center;gap:10px;font-size:17px;line-height:24px;font-weight:700;letter-spacing:-.015em;background:var(--v600);color:#fff;box-shadow:0 1px 2px rgba(16,24,40,.1),inset 0 -2px 0 rgba(16,24,40,.12);transition:background .15s,transform .1s}
.btn:hover{background:var(--v700)}
.btn:active{transform:translateY(1px)}
.btn .i{width:18px;height:18px}
.gbtn{height:56px;padding:0 20px;border-radius:var(--r-f);display:inline-flex;align-items:center;gap:8px;font-size:16px;line-height:24px;font-weight:700;letter-spacing:-.015em;background:var(--g100);color:var(--g800);transition:background .15s}
.gbtn:hover{background:var(--g200)}
.gbtn .i{color:var(--g600)}
.mlk{display:inline-flex;align-items:center;gap:4px;font-size:15px;font-weight:600;color:var(--g600);text-decoration:underline;text-decoration-color:var(--g300);text-underline-offset:4px}
.mlk:hover{color:var(--g900)}
.hx-ko{margin-top:12px;font-size:18px;line-height:28px;font-weight:600;color:var(--g700);letter-spacing:-.015em}
.mis{grid-column:1/-1;margin-top:48px;border-radius:var(--r-l);background:var(--g50);padding:24px 28px;display:grid;grid-template-columns:auto repeat(3,minmax(0,1fr));gap:12px;align-items:stretch}
.mis-h{display:flex;flex-direction:column;justify-content:center;gap:2px;padding-right:20px;min-width:0}
.mis-h b{font-size:18px;line-height:26px;font-weight:800;letter-spacing:-.02em}
.mis-h span{display:inline-flex;align-items:center;gap:4px;font-size:14px;line-height:20px;font-weight:600;color:var(--g600);white-space:nowrap}
.mis-h span .i{color:var(--gold);width:18px;height:18px}
.mi{display:flex;align-items:center;gap:14px;padding:16px 18px;border-radius:16px;background:#fff;box-shadow:0 0 0 1px var(--g200);text-align:left;min-width:0;transition:box-shadow .15s}
.mi:hover{box-shadow:0 0 0 1px var(--g400)}
.mi .no{flex:none;width:36px;height:36px;border-radius:50%;display:grid;place-items:center;font-size:15px;font-weight:800;background:var(--g100);color:var(--g500)}
.mi.now{box-shadow:0 0 0 2px var(--v600)}
.mi.now .no{background:var(--v600);color:#fff}
.mi.done .no{background:var(--okT);color:var(--okD)}
.mi .no .i{width:18px;height:18px}
.mi-t{display:flex;flex-direction:column;min-width:0}
.mi-t b{font-size:15px;line-height:22px;font-weight:700;letter-spacing:-.01em;color:var(--g900)}
.mi-t span{font-size:13px;line-height:18px;font-weight:600;color:var(--g500);letter-spacing:0}
.mi.now .mi-t span{color:var(--v700)}
.mi.done .mi-t span{color:var(--okD)}
.mi .go{margin-left:auto;flex:none;color:var(--g400);width:18px;height:18px}
.hx-foot{margin-top:20px;display:flex;align-items:center;gap:4px;flex-wrap:wrap}
.lk{height:36px;padding:0 10px;border-radius:var(--r-s);display:inline-flex;align-items:center;gap:6px;font-size:14px;line-height:20px;font-weight:600;color:var(--g600);letter-spacing:-.005em}
.lk:first-child{margin-left:-10px}
.lk:hover{background:var(--g100);color:var(--g900)}
.lk .i{width:18px;height:18px;color:var(--g400)}
.lk b{font-weight:700;color:var(--g900)}
.hx-foot .sep{width:1px;height:14px;background:var(--g200);margin:0 6px}
.reward{display:inline-flex;align-items:center;gap:6px;font-size:14px;line-height:20px;font-weight:600;color:var(--g600);padding-left:6px}
.reward .i{color:var(--gold);width:18px;height:18px}
.reward b{color:var(--g900);font-weight:700}

/* ── 섹션 헤더 공통 ── */
.sh{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:28px;flex-wrap:wrap}
.sh-t{display:flex;flex-direction:column;gap:8px;min-width:0}
.sh-t .ov{display:flex;align-items:center;gap:8px}
.sh-t .t-sm{font-size:15px;line-height:24px;color:var(--g500)}

/* ── 함께 읽을 책 : 레벨 큐레이션 ── */
.curate{padding-block:96px 0}
.tally{display:flex;align-items:center;gap:12px;font-size:14px;line-height:20px;color:var(--g500);font-weight:600;letter-spacing:0}
.tally b{color:var(--g900);font-weight:800}
.pips{display:flex;gap:4px}
.pips i{width:24px;height:6px;border-radius:3px;background:var(--g200)}
.pips i.on{background:var(--ok)}
.rgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.rc{display:flex;flex-direction:column;gap:18px;min-width:0}
.rc .tile{position:relative;display:block;width:100%;padding:36px 44px;border-radius:var(--r-l);background:var(--tile);transition:background .2s var(--E)}
.rc:hover .tile{background:var(--tileH)}
.rc .cv{border-radius:10px;box-shadow:var(--sh-cv);transition:transform .3s var(--E),box-shadow .3s var(--E)}
.rc:hover .cv{transform:translateY(-4px);box-shadow:var(--sh-cvH)}
.tag{position:absolute;left:14px;top:14px;display:inline-flex;align-items:center;gap:4px;height:26px;padding:0 10px;border-radius:var(--r-f);background:#fff;font-size:12px;line-height:16px;font-weight:800;letter-spacing:0;box-shadow:0 1px 2px rgba(16,24,40,.08)}
.tag.rec{color:var(--v700)}
.tag.ok{color:var(--okD)}
.tag .i{width:14px;height:14px}
.rc-b{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;padding:0 4px;min-width:0}
.rc-tx{display:flex;flex-direction:column;gap:4px;min-width:0}
.rc-tx h3{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rc-tx h3 button{text-align:left}
.rc-tx h3 button:hover{color:var(--v700)}
.rc-st{font-size:15px;line-height:22px;color:var(--g600);font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cheer{position:absolute;right:14px;bottom:-6px;width:64px;height:auto;z-index:2;pointer-events:none;filter:drop-shadow(0 4px 6px rgba(16,24,40,.15))}
.rc .tile{overflow:hidden}
.rc-st.ok{color:var(--okD);font-weight:700}
.rc-st.ing b{color:var(--v700);font-weight:800}
.cbtn{flex:none;width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:var(--g100);color:var(--g800);transition:background .15s,transform .1s}
.cbtn:hover{background:var(--g200)}
.cbtn:active{transform:scale(.96)}
.cbtn.pri{background:var(--v600);color:#fff}
.cbtn.pri:hover{background:var(--v700)}
.cbtn .i{width:18px;height:18px}

/* ── 다음 책 안내 ── */
.nx{margin-top:40px;display:grid;grid-template-columns:minmax(0,1fr) auto 360px;gap:32px;align-items:center;padding:24px 32px 24px 24px;border-radius:var(--r-l);border:1px solid var(--g200)}
.nx-l{display:flex;align-items:center;gap:20px;min-width:0}
.nx-cv{position:relative;flex:0 0 88px}
.nx-cv .cv{border-radius:8px;filter:grayscale(.7);opacity:.55}
.nx-cv .lk2{position:absolute;inset:0;display:grid;place-items:center}
.nx-cv .lk2 span{width:36px;height:36px;border-radius:50%;background:#fff;display:grid;place-items:center;color:var(--g700);box-shadow:0 2px 6px rgba(16,24,40,.14)}
.nx-tx{display:flex;flex-direction:column;gap:4px;min-width:0}
.nx-tx h3{font-size:20px;line-height:28px;font-weight:800;letter-spacing:-.02em}
.nx-div{width:1px;height:64px;background:var(--g200)}
.nx-r{display:flex;flex-direction:column;gap:10px}
.nx-r .row{display:flex;justify-content:space-between;align-items:baseline}
.nx-r .row b{font-size:15px;font-weight:800;color:var(--g900)}
.nx-r .bar{height:8px}
.nx-r .bar i{background:var(--ok)}
.nx-r .t-sm b{color:var(--g900);font-weight:700}

.endpad{height:128px}

/* ── 전체 책장 ── */
.lib-h{padding-block:48px 24px;display:flex;flex-direction:column;gap:8px}
.ltabs{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px}
.ltabs::-webkit-scrollbar{display:none}
.lt{flex:0 0 auto;height:44px;padding:0 18px;border-radius:var(--r-f);display:inline-flex;align-items:center;gap:8px;font-size:15px;line-height:22px;font-weight:700;color:var(--g600);background:var(--g100);letter-spacing:-.01em}
.lt:hover{background:var(--g200);color:var(--g900)}
.lt .n{font-size:12px;font-weight:700;color:var(--g400)}
.lt[aria-selected="true"]{background:var(--g900);color:#fff}
.lt[aria-selected="true"] .n{color:var(--g400)}
.lt.out{color:var(--g400);background:var(--g50)}
.lt .i{color:var(--g400)}
.subrow{display:flex;align-items:center;gap:6px;margin-top:20px;flex-wrap:wrap}
.sp{height:36px;padding:0 14px;border-radius:var(--r-s);font-size:14px;line-height:20px;font-weight:700;color:var(--g600);display:inline-flex;align-items:center;gap:6px;letter-spacing:-.005em}
.sp:hover{background:var(--g100);color:var(--g900)}
.sp .n{font-size:12px;color:var(--g400);font-weight:600}
.sp[aria-pressed="true"]{background:var(--v50);color:var(--v700)}
.sp[aria-pressed="true"] .n{color:var(--v600)}
.scope{margin-left:auto;display:flex;gap:16px;flex-wrap:wrap;font-size:13px;line-height:18px;color:var(--g500);font-weight:600;letter-spacing:0}
